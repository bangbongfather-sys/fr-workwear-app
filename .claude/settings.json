{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && git pull 2>&1 | tail -5",
            "statusMessage": "GitHub에서 최신 코드 가져오는 중..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '[필수 지침] 이 프로젝트에서는 사용자에게 보이는 모든 글(최종 답변, 작업 중 진행 메모, 도구 호출 설명, 대기 안내, 오류·훅 알림에 대한 답)을 한국어로만 쓴다. 영어 문장은 한 줄도 쓰지 않는다. 보내기 전에 영어가 섞였는지 확인한다.'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/korean-check.py\"",
            "statusMessage": "답변에 영어 문장이 섞였는지 검사 중..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && git add -A && git diff --staged --quiet || (git commit -m \"auto: $(hostname -s) $(date '+%Y-%m-%d %H:%M')\" && git push)",
            "statusMessage": "GitHub에 저장 중..."
          }
        ]
      }
    ]
  }
}
